#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""会话开头跑一次：有新版就**自己装上**，不用问使用者、不用他打任何命令。

    python3 bin/check-update            # 默认：该更新就更新。没更新时一个字都不打印
    python3 bin/check-update --dry-run  # 只看有没有新版，不动文件（0=已最新，10=有新版）

⚠️ 为什么是「自动装」而不是「提示一句让他自己去跑」：
   使用者不一定懂命令行——多数人是跟自己的 AI 说话，不是敲终端。
   「打印一行让他自己去跑安装」＝ **他会永远停在旧版**。

⚠️ 为什么是 Python 不是 sh：**Windows 没有 sh**。上一版是 sh 脚本，
   在那些机器上连跑都跑不起来——「自动更新」建在一个不是人人都有的东西上。

不自动装的唯一情况是**本地改过文件**（只有 git 装的那份能判断），
那时说一声、列出改了哪些，交给使用者决定。
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
import portable  # noqa: E402

HERE = portable.root_of(__file__)


def main():
    dry = "--dry-run" in sys.argv[1:]

    if dry:
        slug = portable.repo_slug(HERE)
        if not slug:
            return 0
        new = portable.remote_version(slug)
        if new is None:                      # 连不上：静默当作已最新
            return 0
        return 0 if new == portable.version(HERE) else 10

    state, old, new = portable.self_update(HERE)

    if state == "updated":
        # 顺手把底座也带到最新，免得只更新了外壳。⛔ 全程静默，不刷屏。
        try:
            portable.ensure_base(HERE, quiet=True)
        except Exception:
            pass
        print("✓ 问藏 skill 已自动更新：%s → %s" % (old or "?", new or "?"))
    elif state == "dirty":
        print("问藏 skill 有新版本，但本地改过文件，没有自动更新。")
        print("改过的是：")
        for f in portable.dirty_files(HERE):
            print("    " + f)
        print('确认这些改动不要了，就跑：git -C "%s" checkout -B main FETCH_HEAD' % HERE)
    # same / offline → 一个字都不打印，直接往下走
    return 0


if __name__ == "__main__":
    sys.exit(main())
