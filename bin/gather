#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""一次把几个词的材料全取回来：词形、分层分布、检索，并发发出，一次吐一份摘要。

    python3 bin/gather lasuṇa
    python3 bin/gather sāriputta upatissa --limit 40
    python3 bin/gather parivāsa --tags vinaya

比一条条敲快，少来回好几趟。

⚠️ **取数上限与 SKILL.md 一致**，别自己放大：一次 40 条、低频词全取、
   高频词看前 8 段。要翻页用 --offset。

⚠️ 只用 Python 标准库。
"""
import argparse
import json
import os
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor

HERE = os.path.dirname(os.path.abspath(__file__))
WP = os.path.join(HERE, "wp")

# ⚠️ 与网页版同一个数：同时在跑的子进程上限。
#    再多不会更快（瓶颈是网络往返），只会一起挤内存。
MAX_PARALLEL = 6


def wp(args):
    """跑一次 bin/wp，返回 (成功?, 文本)。失败不抛，让别的词照常进行。"""
    try:
        # ⚠️ 必须显式用 sys.executable 起 bin/wp，不能直接执行它——
        #    直接执行靠的是 shebang 与可执行位，**Windows 上两样都没有**。
        p = subprocess.run([sys.executable, WP] + args,
                           capture_output=True, timeout=120)
    except subprocess.TimeoutExpired:
        return False, "（超时）"
    out = (p.stdout or b"").decode("utf-8", "replace").strip()
    err = (p.stderr or b"").decode("utf-8", "replace").strip()
    if p.returncode != 0:
        return False, (err or out or "（失败）").splitlines()[-1]
    return True, out


def head(text, n):
    lines = [l for l in text.splitlines() if l.strip()]
    more = len(lines) - n
    body = "\n".join(lines[:n])
    return body + (("\n  …（还有 %d 行，要全文自己跑 python3 bin/wp）" % more) if more > 0 else "")


def main():
    ap = argparse.ArgumentParser(
        description="并发取材料：每个词同时查词形、分布、检索")
    ap.add_argument("words", nargs="+", help="巴利词，可给多个")
    ap.add_argument("--limit", type=int, default=40,
                    help="每词检索取几条（默认 40，与 SKILL.md 一致）")
    ap.add_argument("--offset", type=int, default=0, help="翻页")
    ap.add_argument("--tags", default="", help="按层次/部类收窄，如 vinaya、mūla")
    a = ap.parse_args()

    jobs = []
    for w in a.words:
        jobs.append((w, "forms", ["forms", w]))
        jobs.append((w, "dist", ["dist", "--lemma", w] +
                     (["--tags", a.tags] if a.tags else [])))
        s = ["search", "--lemma", w, "--limit", str(a.limit)]
        if a.offset:
            s += ["--offset", str(a.offset)]
        if a.tags:
            s += ["--tags", a.tags]
        jobs.append((w, "search", s))

    res = {}
    with ThreadPoolExecutor(max_workers=MAX_PARALLEL) as ex:
        futs = {ex.submit(wp, args): (w, kind) for w, kind, args in jobs}
        for f, (w, kind) in futs.items():
            res[(w, kind)] = f.result()

    for w in a.words:
        print("═" * 66)
        print("词：%s" % w)
        print("═" * 66)

        ok, txt = res[(w, "forms")]
        print("\n── 词形（铁律 2：没展开就检索会返回 0 条且不报错）──")
        if not ok:
            print("  ⚠️ %s" % txt)
            print("  ⚠️ **展不开词形＝这个词在语料里不存在或拼错了。**")
            print("     先怀疑变音符号（bhīsakka 全语料 1 句，bhisakka 42 句），别当成「三藏里没有」。")
        else:
            print(head(txt, 6))

        ok, txt = res[(w, "dist")]
        print("\n── 分层分布（决定答案该从哪一层展开）──")
        print(head(txt, 8) if ok else "  ⚠️ %s" % txt)

        ok, txt = res[(w, "search")]
        print("\n── 检索命中 ──")
        print(head(txt, 14) if ok else "  ⚠️ %s" % txt)
        print()

    print("─" * 66)
    print("下一步：从上面的命中里挑坐标，用 python3 bin/wp get <坐标> <坐标> … 取原文。")
    print("⚠️ 命中的常常是**标题**，正文在后面——记得往后连读（见 SKILL.md）。")


if __name__ == "__main__":
    main()
